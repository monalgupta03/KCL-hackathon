# A hostname you control, with DNS pointing to your Vultr VM. No scheme or path.
SITE_DOMAIN=savourit.example.com
DEMO_USERNAME=demo
# Paste the output of: sudo docker run --rm -it caddy:2-alpine caddy hash-password
# Keep single quotes around the hash so Compose preserves its dollar signs.
DEMO_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
